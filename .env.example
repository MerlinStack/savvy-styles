# ---------------------------------------------------------------------------
# Savvy Style — environment template
# Copy to .env.local and fill in real values. Never commit credentials.
# ---------------------------------------------------------------------------

# Public origin used for canonical URLs, sitemap and Open Graph metadata.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional public contact details. Leave blank until the owner confirms them;
# the footer and contact page hide these surfaces when unset.
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_INSTAGRAM_URL=""

# Search indexing is disabled unless explicitly enabled. Fixture catalogue data
# must not be indexed as if it were real inventory.
NEXT_PUBLIC_ALLOW_INDEXING="false"

# Canonical PostgreSQL database. Required before order/admin features can run.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/savvy_style?schema=public"

# Paystack — server-side secret. Do not expose this to the browser.
PAYSTACK_SECRET_KEY=""
# Optional: only needed if a client-side Paystack inline flow is introduced.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# Cloudinary — product media storage and delivery.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Transactional email. Required before order notifications are enabled.
RESEND_API_KEY=""
EMAIL_FROM=""

# Exchange rates. NGN is the accounting currency; these rates are display-only.
# The application ships with clearly labelled development fallback rates.
EXCHANGE_RATE_API_KEY=""
EXCHANGE_RATE_API_URL=""

# Local development capture for the newsletter form.
# Writes to .data/newsletter.ndjson. Disable/false in production.
NEWSLETTER_DEV_STORE="true"

# Local development capture for the contact form.
# Writes to .data/contact.ndjson. Disable/false in production.
CONTACT_DEV_STORE="true"
